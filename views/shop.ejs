<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NEXORA - Shop</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<nav>

    <div class="logo">NEXORA</div>

    <div class="nav-links">

        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/cart">Cart</a>

        <% if (user) { %>

            <a href="/orders">Orders</a>
            <a href="/logout">Logout</a>

        <% } else { %>

            <a href="/login">Login</a>

        <% } %>

    </div>

</nav>


<section class="shop-container">

    <h1>Shop Products</h1>

    <div class="product-grid">

        <% products.forEach(product => { %>

            <div class="product-card">

                <img
                    src="<%= product.image %>"
                    alt="<%= product.name %>"
                >

                <h3>
                    <%= product.name %>
                </h3>

                <p>
                    <%= product.category %>
                </p>

                <h3 class="price">
                    ₹<%= product.price %>
                </h3>

                <a
                    href="/product/<%= product._id %>"
                    class="btn"
                >
                    View Details
                </a>

            </div>

        <% }) %>

    </div>

</section>


<footer>

    <p>© 2026 NEXORA</p>

</footer>
<script src="/main.js"1></script>
</body>
</html>